{
  "version": 1,
  "stale_days": 45,
  "cases": [
    {
      "id": "node_modules_stale_in_project",
      "setup": [
        { "path": "package.json", "content": "{}" },
        { "path": "pnpm-lock.yaml", "content": "lockfileVersion: 9" },
        { "path": "node_modules", "type": "dir" }
      ],
      "targets": [{ "kind": "node_modules", "rel_path": "node_modules", "age_days": 80 }],
      "expect": [
        {
          "risk": "safe",
          "safety_class": "project_artifact",
          "reason_codes": ["NODE_MODULES_STALE", "PROJECT_MARKERS_PRESENT"]
        }
      ]
    },
    {
      "id": "node_modules_fresh_in_project",
      "setup": [
        { "path": "package.json", "content": "{}" },
        { "path": "pnpm-lock.yaml", "content": "lockfileVersion: 9" },
        { "path": "node_modules", "type": "dir" }
      ],
      "targets": [{ "kind": "node_modules", "rel_path": "node_modules", "age_days": 0 }],
      "expect": [
        {
          "risk": "review",
          "safety_class": "project_artifact",
          "reason_codes": ["NODE_MODULES_NOT_STALE", "PROJECT_MARKERS_PRESENT"]
        }
      ]
    },
    {
      "id": "node_modules_outside_project",
      "setup": [{ "path": "node_modules", "type": "dir" }],
