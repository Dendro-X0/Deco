{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deco disk cleanup config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "roots": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeModules": { "type": "boolean" },
        "buildArtifacts": { "type": "boolean" },
        "rustArtifacts": { "type": "boolean" },
        "goArtifacts": { "type": "boolean" },
        "playwrightArtifacts": { "type": "boolean" }
      }
    },
    "additionalDirNames": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buildArtifacts": { "type": "array", "items": { "type": "string" } },
        "rustArtifacts": { "type": "array", "items": { "type": "string" } },
        "goArtifacts": { "type": "array", "items": { "type": "string" } },
        "playwrightArtifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "excludeAbsPathContains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "profile": {
      "type": "string",
      "enum": ["safe", "balanced", "aggressive"]
    },
    "deleteMode": {
      "type": "string",
      "enum": ["quarantine", "recycle-bin", "hard-delete"]
    },
    "staleDays": {
      "type": "integer",
      "minimum": 0
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string" },
        "retentionDays": { "type": "integer", "minimum": 0 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extraProtectedPathContains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowPathContains": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "required": ["roots", "maxDepth", "targets"]
}