{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deco",
  "version": "0.7.0",
  "identifier": "com.dendrox.deco",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeDevCommand": "pnpm -F @dendro-x0/deco-frontend dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deco",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
