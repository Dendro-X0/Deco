{
  "$schema": "./config.schema.json",
  "roots": [
    "E:/Experimental projects"
  ],
  "maxDepth": 6,
  "targets": {
    "nodeModules": true,
    "buildArtifacts": true,
    "rustArtifacts": true,
    "goArtifacts": false,
    "playwrightArtifacts": true
  },
  "profile": "safe",
  "deleteMode": "quarantine",
  "staleDays": 45,
  "additionalDirNames": {
    "buildArtifacts": [".turbo", ".vite"],
    "rustArtifacts": [".cargo-target"],
    "goArtifacts": ["bin", "out"]
  },
  "excludeAbsPathContains": [
    "/Windows/",
    "/Program Files/"
  ],
  "quarantine": {
    "root": "E:/.deco-quarantine",
    "retentionDays": 30
  },
  "safety": {
    "extraProtectedPathContains": [
      "/tools/ide-runtime/"
    ],
    "allowPathContains": [
      "/sandbox/test-fixtures/"
    ]
  }
}