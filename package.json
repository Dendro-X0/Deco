{
  "name": "@dendro-x0/deco-monorepo",
  "private": true,
  "version": "0.4.0",
  "description": "Monorepo for Deco: Disk Cleanup for Developers",
  "scripts": {
    "dev:cli": "pnpm -F @dendro-x0/deco-cli start",
    "build:cli": "pnpm -F @dendro-x0/deco-cli build",
    "dev:desktop": "pnpm -F @dendro-x0/deco-desktop dev",
    "build:desktop": "pnpm build:frontend && pnpm -F @dendro-x0/deco-desktop build",
    "dev:frontend": "pnpm -F @dendro-x0/deco-frontend dev",
    "build:frontend": "pnpm -F @dendro-x0/deco-frontend build",
    "test": "pnpm test:cli",
    "test:cli": "pnpm -F @dendro-x0/deco-cli test",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:all": "pnpm test:cli && pnpm test:rust",
    "package:cli": "pnpm build:cli && node scripts/package-cli.mjs",
    "icons:generate": "python scripts/generate-deco-icon.py && pnpm -F @dendro-x0/deco-desktop exec tauri icon src-tauri/icons/app-icon.png",
    "install:all": "pnpm install",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "pnpm": "^9.0.0"
  }
}
